{
  "title": "外接 USB 键盘：Option + 空格 唤出 Spotlight",
  "rules": [
    {
      "description": "唤出 Spotlight：Option + 空格 映射为 Command + 空格（仅限指定 USB 接收器键盘）",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "spacebar",
            "modifiers": {
              "mandatory": [
                "option"
              ],
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "spacebar",
              "modifiers": [
                "command"
              ]
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 7847,
                  "product_id": 104,
                  "is_keyboard": true
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}

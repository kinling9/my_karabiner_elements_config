{
  "title": "Windows 习惯：Option + Tab 切换应用",
  "rules": [
    {
      "description": "应用切换：Option + Tab 映射为 Command + Tab（支持任务切换器，Shift 反向切换）",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "tab",
            "modifiers": {
              "mandatory": [
                "left_option"
              ],
              "optional": [
                "shift",
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "tab",
              "modifiers": [
                "left_command"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "tab",
            "modifiers": {
              "mandatory": [
                "right_option"
              ],
              "optional": [
                "shift",
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "tab",
              "modifiers": [
                "right_command"
              ]
            }
          ]
        }
      ]
    }
  ]
}

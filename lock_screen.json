{
  "title": "锁屏习惯：Command + L 锁定屏幕",
  "rules": [
    {
      "description": "锁定屏幕：Command + L 映射为 Control + Command + Q",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "l",
            "modifiers": {
              "mandatory": [
                "command"
              ],
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "q",
              "modifiers": [
                "control",
                "command"
              ]
            }
          ]
        }
      ]
    }
  ]
}
